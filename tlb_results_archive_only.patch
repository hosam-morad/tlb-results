+#!/usr/bin/env python3
+"""Build dashboard STLB-state compatibility inputs from the archived result CSV.
+
+The dashboard historically read:
+  simulations/.../<pair>/<repeat>/mode_selection.log
+
+The compact archive now carries the pair-level ownership percentages directly:
+  stlb_shared_percent
+  stlb_thread1_only_percent
+  stlb_thread2_only_percent
+
+This helper reconstructs an equivalent mode_selection.log tree from those
+percentages.  It is intentionally a compatibility layer: the dashboard's
+existing stlb_state.py and JSON/rendering semantics remain unchanged, but no
+raw simulation directory is needed by tlb-results.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import shutil
+from pathlib import Path
+
+PERCENT_COLUMNS = (
+    "stlb_shared_percent",
+    "stlb_thread1_only_percent",
+    "stlb_thread2_only_percent",
+)
+
+# Percentages are archived with two decimal places.  10,000 equal-weight rows
+# reproduce them exactly to 0.01 percentage point.
+TOTAL_ROWS = 10_000
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--input", required=True, help="Archived uniform all_workloads.csv")
+    parser.add_argument("--output-root", required=True)
+    parser.add_argument("--repeat", default="repeat0")
+    return parser.parse_args()
+
+
+def parse_benchmark(value: str) -> tuple[str, str]:
+    if "|" not in value:
+        raise ValueError(f"invalid benchmark field {value!r}; expected focal|corunner")
+    focal, corunner = value.split("|", 1)
+    if not focal or not corunner:
+        raise ValueError(f"invalid benchmark field {value!r}")
+    return focal, corunner
+
+
+def percentages(row: dict[str, str]) -> tuple[float, float, float]:
+    result = tuple(float(row[column]) for column in PERCENT_COLUMNS)
+    if any(value < 0.0 or value > 100.0 for value in result):
+        raise ValueError(f"invalid STLB percentages for {row.get('benchmark')}: {result}")
+    total = sum(result)
+    if abs(total - 100.0) > 0.02:
+        raise ValueError(
+            f"STLB percentages do not sum to 100 for {row.get('benchmark')}: "
+            f"{result} -> {total}"
+        )
+    return result
+
+
+def row_counts(values: tuple[float, float, float]) -> tuple[int, int, int]:
+    # Keep the first two rounded archive percentages and put the rounding
+    # remainder in mode 2 so the total is always exactly TOTAL_ROWS.
+    shared = round(values[0] * 100)
+    thread1 = round(values[1] * 100)
+    thread2 = TOTAL_ROWS - shared - thread1
+    if min(shared, thread1, thread2) < 0:
+        raise ValueError(f"cannot convert percentages to counts: {values}")
+    return shared, thread1, thread2
+
+
+def same_percentages(
+    left: tuple[float, float, float],
+    right: tuple[float, float, float],
+) -> bool:
+    return all(abs(a - b) <= 0.011 for a, b in zip(left, right))
+
+
+def load_pairs(path: Path) -> list[tuple[str, tuple[float, float, float]]]:
+    with path.open(newline="", encoding="utf-8") as f:
+        rows = list(csv.DictReader(f))
+
+    if not rows:
+        raise ValueError(f"{path}: no data rows")
+
+    columns = set(rows[0])
+    required = {"benchmark", *PERCENT_COLUMNS}
+    missing = sorted(required - columns)
+    if missing:
+        raise ValueError(f"{path}: missing columns: {', '.join(missing)}")
+
+    directional: dict[tuple[str, str], tuple[float, float, float]] = {}
+    ordered_keys: list[tuple[str, str]] = []
+    for row in rows:
+        key = parse_benchmark(row["benchmark"].strip())
+        value = percentages(row)
+        if key not in directional:
+            ordered_keys.append(key)
+        elif not same_percentages(directional[key], value):
+            raise ValueError(f"{path}: inconsistent duplicate row for {key[0]}|{key[1]}")
+        directional[key] = value
+
+    pairs: list[tuple[str, tuple[float, float, float]]] = []
+    handled: set[tuple[str, str]] = set()
+
+    for first, second in ordered_keys:
+        canonical = tuple(sorted((first, second)))
+        if canonical in handled:
+            continue
+
+        value = directional[(first, second)]
+        reverse = directional.get((second, first))
+        if reverse is None:
+            raise ValueError(f"{path}: missing reverse row {second}|{first}")
+        if not same_percentages(value, reverse):
+            raise ValueError(
+                f"{path}: STLB percentages differ between "
+                f"{first}|{second}={value} and {second}|{first}={reverse}"
+            )
+
+        # The archive collector writes the simulator directory's orientation
+        # first, followed by its reverse focal row.  Preserve that orientation.
+        pairs.append((f"{first}+{second}", value))
+        handled.add(canonical)
+
+    return pairs
+
+
+def write_mode_log(
+    output_root: Path,
+    pair: str,
+    repeat: str,
+    values: tuple[float, float, float],
+) -> None:
+    path = output_root / pair / repeat / "mode_selection.log"
+    path.parent.mkdir(parents=True, exist_ok=True)
+
+    counts = row_counts(values)
+    with path.open("w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        # Include both names used by historical analysis code.  Keeping them
+        # equal makes either reader interpretation reproduce the archive.
+        writer.writerow(["time", "previous_mode", "winner_mode"])
+        time_index = 0
+        for mode, count in enumerate(counts):
+            for _ in range(count):
+                writer.writerow([time_index, mode, mode])
+                time_index += 1
+
+
+def main() -> int:
+    args = parse_args()
+    input_path = Path(args.input)
+    output_root = Path(args.output_root)
+
+    if output_root.exists():
+        shutil.rmtree(output_root)
+    output_root.mkdir(parents=True)
+
+    pairs = load_pairs(input_path)
+    for pair, values in pairs:
+        write_mode_log(output_root, pair, args.repeat, values)
+
+    print(
+        f"Generated archive-only STLB state for {len(pairs)} pair(s) "
+        f"under {output_root}"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
